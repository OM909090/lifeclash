# ---------------------------------------------------------------------------
# LifeClash environment
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). Without these, the app runs in local-play
# mode (no persistence) — the deployed submission MUST have them set.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (inlined into the client bundle).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose to the browser. Used by scripts/admin tasks
# (e.g. seeding the demo clan/raid). Not required for normal app operation.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: the public origin, used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
